<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>TrayAppSetup</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>arm64</InstallerPlatform>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)payload</PayloadDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PayloadDir=$(PayloadDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Product.wxs" />
    <Compile Include="Payload.generated.wxs" />
  </ItemGroup>
</Project>
