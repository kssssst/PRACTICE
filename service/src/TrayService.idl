[
    uuid(12345678-1234-1234-1234-123456789abc),
    version(1.0)
]
interface ITrayService
{
    typedef struct AuthUserInfo
    {
        long authenticated;
        long errorCode;
        [string] wchar_t email[256];
        [string] wchar_t message[512];
    } AuthUserInfo;

    typedef struct LicenseInfo
    {
        long hasLicense;
        long blocked;
        long errorCode;
        [string] wchar_t activationDate[64];
        [string] wchar_t expirationDate[64];
        [string] wchar_t deviceMac[64];
        [string] wchar_t message[512];
    } LicenseInfo;

    typedef struct AvDatabaseInfo
    {
        long loaded;
        long recordCount;
        [string] wchar_t releaseDate[64];
        [string] wchar_t message[512];
    } AvDatabaseInfo;

    typedef struct ScanResult
    {
        long scannedFiles;
        long infectedFiles;
        long errorCode;
        [string] wchar_t threatName[128];
        [string] wchar_t objectPath[260];
        [string] wchar_t message[1024];
    } ScanResult;

    error_status_t StopService();
    error_status_t GetServiceStatus([out] long *status);
    error_status_t GetCurrentUser([out] AuthUserInfo *info);
    error_status_t Login([in, string] wchar_t *email,
                         [in, string] wchar_t *password,
                         [out] AuthUserInfo *info);
    error_status_t Logout();
    error_status_t GetLicenseInfo([out] LicenseInfo *info);
    error_status_t ActivateProduct([in, string] wchar_t *activationKey,
                                   [out] LicenseInfo *info);
    error_status_t GetAvDatabaseInfo([out] AvDatabaseInfo *info);
    error_status_t UpdateAvDatabase([out, string] wchar_t message[512]);
    error_status_t ScanFile([in, string] wchar_t *path,
                            [out] ScanResult *result);
    error_status_t ScanDirectory([in, string] wchar_t *path,
                                 [out] ScanResult *result);
    error_status_t ScanFixedDrives([out] ScanResult *result);
    error_status_t ConfigureScheduledScan([in] long enabled,
                                          [in] long intervalMinutes,
                                          [in, string] wchar_t *path,
                                          [out, string] wchar_t message[512]);
    error_status_t ConfigureDirectoryMonitoring([in] long enabled,
                                                [in, string] wchar_t *path,
                                                [out, string] wchar_t message[512]);
    error_status_t GetLastBackgroundScanResult([out] ScanResult *result);
};
